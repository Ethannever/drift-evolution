; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Drift Evolution"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]
GameManager="*res://scripts/core/game_manager.gd"
WorldManager="*res://scripts/core/world_manager.gd"
Transition="*res://scenes/transition.tscn"
AIService="*res://scripts/ai/ai_service.gd"
ContentRegistry="*res://scripts/core/content_registry.gd"
GameEvolutionSystem="*res://scripts/core/game_evolution_system.gd"
GameState="*res://scripts/core/game_state.gd"
AIEvolution="*res://scripts/ai_evolution/ai_evolution_engine.gd"
CombatSystem="*res://scripts/combat/combat_system.gd"
BugHunterSystem="*res://scripts/ai_evolution/bug_hunter_system.gd"
TestTaskManager="*res://scripts/ai_evolution/test_task_manager.gd"
EvolutionSystem="*res://scripts/systems/evolution_system.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="viewport"
window/stretch/aspect="expand"

